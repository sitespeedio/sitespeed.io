{
  "annotations": {
    "list": []
  },
  "description": "Test results for one URL stored in OpenSearch: the latest tests with links to their results, the results per browser, every run, the significant changes from compare and the trends. Enable with --opensearch.host.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Choose a URL. OpenSearch stores every test as a document with text fields, so for that URL this dashboard can do what Graphite cannot: **list the tests with a link to each HTML result**, **group the results by any field when you query**, for example by browser, **keep every run** and not only the median, and **show which metrics changed** in a comparison. Use *Filters* to filter on any field, for example `slug` or `group`. To compare pages, use the Leaderboard."
      },
      "id": 200,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Latest tests for $url",
      "collapsed": false,
      "panels": [],
      "id": 201,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "table",
      "title": "Latest tests",
      "description": "One row for each test of the URL, newest first. Click the URL to open the HTML result of that test (needs --resultBaseURL). Graphite only stores numbers, so it cannot keep the test name or the link.",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "sitespeed-opensearch"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "sitespeed-opensearch"
          },
          "query": "type:pageSummary AND url:\"$url\" AND browser:$browser AND connectivity:$connectivity AND deviceType:$deviceType",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "100"
              }
            }
          ],
          "bucketAggs": [],
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "url",
                "browser",
                "connectivity",
                "slug",
                "googleWebVitals.lcp.median",
                "googleWebVitals.cls.median",
                "timings.ttfb.median",
                "resultUrl"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "@timestamp": 0,
              "url": 1,
              "browser": 2,
              "connectivity": 3,
              "slug": 4,
              "googleWebVitals.lcp.median": 5,
              "googleWebVitals.cls.median": 6,
              "timings.ttfb.median": 7,
              "resultUrl": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "resultUrl"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "URL"
              },
              {
                "id": "custom.width",
                "value": 380
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the HTML result",
                    "url": "${__data.fields.resultUrl}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "googleWebVitals.lcp.median"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "LCP"
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "googleWebVitals.cls.median"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CLS"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "timings.ttfb.median"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TTFB"
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "@timestamp"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time"
              },
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "slug"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Test"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "browser"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Browser"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "connectivity"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Connectivity"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
