    {
      "type": "histogram",
      "title": "LCP of every run",
      "description": "How the LCP of every single run is spread, for the URL. A wide spread means unstable runs. Graphite only gets the median and percentiles of each test, so this needs --opensearch.includeRuns.",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "sitespeed-opensearch-runs"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "sitespeed-opensearch-runs"
          },
          "query": "url:\"$url\" AND browser:$browser AND connectivity:$connectivity AND deviceType:$deviceType",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "5000"
              }
            }
          ],
          "bucketAggs": [],
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
