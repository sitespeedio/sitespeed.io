    {
      "type": "timeseries",
      "title": "LCP per browser",
      "description": "The LCP median over time, one line for each browser. Change the field to group by connectivity, device or test name: OpenSearch decides the grouping when you query.",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "sitespeed-opensearch"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "sitespeed-opensearch"
          },
          "query": "type:pageSummary AND url:\"$url\" AND connectivity:$connectivity AND deviceType:$deviceType",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "googleWebVitals.lcp.median",
              "settings": {}
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "browser",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "1"
              }
            }
          ],
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 205,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      }
