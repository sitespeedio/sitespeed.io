    {
      "type": "timeseries",
      "title": "LCP percentiles over all runs",
      "description": "The 50th, 75th and 95th percentile of LCP over every run in each time bucket, for the URL. These are real percentiles over the runs, not an average of medians. Needs --opensearch.includeRuns.",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "sitespeed-opensearch-runs"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "sitespeed-opensearch-runs"
          },
          "query": "url:\"$url\" AND browser:$browser AND connectivity:$connectivity AND deviceType:$deviceType",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "googleWebVitals.lcp",
              "settings": {
                "percents": [
                  "50",
                  "75",
                  "95"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "1"
              }
            }
          ],
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^p([0-9]+)\\.0 .*$",
            "renamePattern": "p$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 208,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 25
      }
