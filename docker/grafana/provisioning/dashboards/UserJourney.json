{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "sitespeedio-user-journey"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "datasource",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "graphite",
            "version": "v0",
            "datasource": {
              "name": "graphite"
            },
            "spec": {
              "fromAnnotations": true,
              "queryType": "tags",
              "tags": [
                "$base",
                "$path",
                "$group",
                "$page",
                "$browser",
                "$connectivity",
                "$testname"
              ]
            }
          },
          "enable": false,
          "hide": false,
          "iconColor": "rgb(96, 255, 103)",
          "name": "Go to result",
          "legacyOptions": {
            "limit": 100,
            "showIn": 0,
            "tags": "$base $path $group $page $browser $connectivity $testname",
            "type": "alert"
          }
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "datasource",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [
                "sitespeed.io"
              ],
              "type": "tags"
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "#8AB8FF",
          "name": "sitespeed.io",
          "legacyOptions": {
            "limit": 100,
            "showIn": 0,
            "tags": [
              "sitespeed.io"
            ],
            "type": "tags"
          }
        }
      },
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "datasource",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": true,
              "tags": [
                "alert"
              ],
              "type": "tags"
            }
          },
          "enable": false,
          "hide": false,
          "iconColor": "red",
          "name": "Alerts"
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "One tab for each page in a scripted user journey.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "content": "Each page in the user journey gets its own tab. Choose the test with <i>path</i>, <i>testname</i> and <i>domain</i>. The screenshot and video are from the last run and need <code>--copyLatestFilesToBase</code> and <code>--copyLatestFilesToBaseGraphiteNamespace</code>, see <a href=\"https://www.sitespeed.io/documentation/sitespeed.io/performance-dashboard/#how-to-get-the-latest-video-screenshot-visible-in-grafana\">the documentation</a>.",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Requests",
          "description": "Total number of requests for the page.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "$base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.pagexray.requests",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "none",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A",
                          "color": "transparent"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "text"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Transfer size",
          "description": "Transfer size: the size of all requests over the network, often compressed.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "$base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.pagexray.transferSize",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "none",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A",
                          "color": "transparent"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "text"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Screenshot",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "content": "<a href=\"$resulturl/$testname/$base.$path.$group.$page.$browser.$connectivity.$screenshottype\"><img src=\"$resulturl/$testname/$base.$path.$group.$page.$browser.$connectivity.$screenshottype\" width=\"100%\"></a>",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Video",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "",
            "spec": {
              "options": {
                "content": "<video controls width=\"100%\" src=\"$resulturl/$testname/$base.$path.$group.$page.$browser.$connectivity.mp4\"></video>",
                "mode": "html"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Timings",
          "description": "The $function of the runs in each test.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "alias($base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.ttfb.$function, 'TTFB')",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "alias($base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.firstContentfulPaint.$function, 'First Contentful Paint')",
                        "textEditor": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "alias($base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.largestContentfulPaint.$function, 'Largest Contentful Paint')",
                        "textEditor": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "alias($base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.visualMetrics.SpeedIndex.$function, 'Speed Index')",
                        "textEditor": true
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "min",
                    "max",
                    "lastNotNull"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "First Contentful Paint",
          "description": "First contentful paint: when the browser paints the first text or image. Good is below 1.8 seconds.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "$base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.firstContentfulPaint.$function",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A",
                          "color": "transparent"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 1800,
                        "color": "#EAB839"
                      },
                      {
                        "value": 3000,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Largest Contentful Paint",
          "description": "Largest contentful paint: when the browser paints the largest image or text block in the viewport. Good is below 2.5 seconds.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "$base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.largestContentfulPaint.$function",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A",
                          "color": "transparent"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 2500,
                        "color": "#EAB839"
                      },
                      {
                        "value": 4000,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Cumulative Layout Shift",
          "description": "Cumulative layout shift: how much the content moves while the page loads. Good is below 0.1.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "$base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.cumulativeLayoutShift.$function",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "decimals": 3,
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A",
                          "color": "transparent"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 0.1,
                        "color": "#EAB839"
                      },
                      {
                        "value": 0.25,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Total Blocking Time",
          "description": "Total blocking time: the sum of the time over 50 ms of each long task between first contentful paint and the end of the test. Good is below 200 ms. Chrome only.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "graphite",
                      "version": "v0",
                      "datasource": {
                        "name": "graphite"
                      },
                      "spec": {
                        "target": "$base.$path.$testname.pageSummary.$group.$page.$browser.$connectivity.browsertime.statistics.googleWebVitals.totalBlockingTime.$function",
                        "textEditor": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "N/A",
                          "color": "transparent"
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 200,
                        "color": "#EAB839"
                      },
                      {
                        "value": 600,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "",
              "collapse": false,
              "hideHeader": true,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 2,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "",
              "collapse": false,
              "hideHeader": true,
              "layout": {
                "kind": "TabsLayout",
                "spec": {
                  "tabs": [
                    {
                      "kind": "TabItem",
                      "spec": {
                        "title": "$page",
                        "repeat": {
                          "mode": "variable",
                          "value": "page"
                        },
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 6,
                                  "height": 10,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-3"
                                  }
                                }
                              },
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 6,
                                  "y": 0,
                                  "width": 6,
                                  "height": 10,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-4"
                                  }
                                }
                              },
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 12,
                                  "y": 0,
                                  "width": 12,
                                  "height": 10,
