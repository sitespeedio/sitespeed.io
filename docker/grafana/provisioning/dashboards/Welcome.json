          }
        }
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 6,
      "options": {
        "afterRender": "",
        "content": "{{#each data.[0]}}\n<h3><a href=\"{{link}}\" target=\"_blank\">{{title}}</a></h3>\n<p><em>{{date pubDate 'D MMMM YYYY'}}</em></p>\n{{releaseNotes description}}\n<hr>\n{{/each}}",
        "contentPartials": [],
        "defaultContent": "The query didn't return any results.",
        "editor": {
          "format": "auto",
          "language": "html"
        },
        "editors": [],
        "externalStyles": [],
        "helpers": "// The feed has \"- \" items, because the Grafana news panel removes lists.\n// Show the items as a list.\ncontext.handlebars.registerHelper('releaseNotes', notes => {\n  const html = notes\n    .split('\\n')\n    .map(line => (line.startsWith('- ') ? '<li>' + line.slice(2).replace(/<br>$/, '') + '</li>' : line))\n    .join('\\n')\n    .replaceAll(/((?:<li>.*<\\/li>\\n)+)/g, '<ul>\\n$1</ul>\\n');\n  return new context.handlebars.SafeString(html);\n});\n",
        "renderMode": "data",
        "styles": "li {\n  margin-bottom: 8px;\n}",
        "wrap": false
      },
      "pluginVersion": "6.2.0",
      "targets": [
        {
          "columns": [
            {
              "selector": "title",
              "text": "title",
              "type": "string"
            },
            {
              "selector": "link",
              "text": "link",
              "type": "string"
            },
            {
              "selector": "pubDate",
              "text": "pubDate",
              "timestampFormat": "Mon, 02 Jan 2006 15:04:05 MST",
              "type": "timestamp"
            },
            {
              "selector": "description",
              "text": "description",
              "type": "string"
            }
          ],
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "filters": [],
          "format": "table",
          "global_query_id": "",
          "parser": "backend",
          "refId": "A",
          "root_selector": "rss.channel.item[[0..4]]",
          "source": "url",
          "type": "xml",
          "url": "https://www.sitespeed.io/feed/rss.xml",
          "url_options": {
            "data": "",
            "method": "GET"
          }
        }
      ],
      "title": "Sitespeed.io releases",
      "type": "marcusolsson-dynamictext-panel"
    },
    {
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "description": "Each line is a test (path and test name). Green means that the test sent metrics to Graphite at that time, and the number is how many pages it tested.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No test",
                  "color": "transparent"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 7,
      "options": {
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": false,
        "rowHeight": 0.8,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "graphite",
            "uid": "graphite"
          },
          "refId": "A",
          "target": "groupByNodes(isNonNull(sitespeed_io.*.*.pageSummary.*.*.*.*.browsertime.statistics.timings.ttfb.median), 'sum', 1, 2)",
          "textEditor": true
        }
      ],
      "timeFrom": "24h",
      "title": "Tests the last 24 hours",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "description": "Pages where the last comparison in the last 24 hours found metrics that got significantly slower than the baseline (the same query as the Page got slower alert rule). Click a page to open its Regressions tab.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "noValue": "No page got slower in its last comparison"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "include",
                "names": [
                  "path",
                  "testname"
                ]
              }
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Page"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the Regressions tab",
                    "url": "/d/9NDMzFfMk?var-path=${__data.fields.path}&var-testname=${__data.fields.testname}&var-group=${__data.fields.group}&var-page=${__data.fields.page}&var-browser=${__data.fields.browser}&var-connectivity=${__data.fields.connectivity}&dtab=regressions"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Browser"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Connectivity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Slower metrics"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 13,
        "x": 0,
        "y": 8
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Slower metrics",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "graphite",
            "uid": "graphite"
          },
          "refId": "A",
          "target": "groupByNodes(filterSeries(sitespeed_io.*.*.pageSummary.*.*.*.*.compare.metrics.*.*.isSignificant, 'last', '>', 0), 'count', 1, 2, 4, 5, 6, 7)",
          "textEditor": true
        }
      ],
      "timeFrom": "24h",
      "title": "Pages that got slower",
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Field",
            "format": "regexp",
            "regExp": "/^(?<path>[^.]+)\\.(?<testname>[^.]+)\\.(?<group>[^.]+)\\.(?<page>[^.]+)\\.(?<browser>[^.]+)\\.(?<connectivity>[^.]+)$/"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "indexByName": {
              "page": 0,
              "Last *": 1,
              "group": 2,
              "browser": 3,
              "connectivity": 4,
              "path": 5,
              "testname": 6
            },
            "renameByName": {
              "page": "Page",
              "group": "Domain",
              "browser": "Browser",
              "connectivity": "Connectivity",
              "Last *": "Slower metrics"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Alerts that fire now. The Page got slower rule fires when the last comparison of a page found metrics that got significantly slower.",
      "gridPos": {
        "h": 7,
        "w": 11,
        "x": 13,
        "y": 8
      },
      "id": 9,
      "options": {
        "alertInstanceLabelFilter": "",
