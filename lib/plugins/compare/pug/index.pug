- const compare = pageInfo.data.compare.pageSummary
- const meta = compare.meta
- const baselineRaw = compare.raw.baseline
- const currentRaw = compare.raw.current
- const baselineXray = baselineRaw.pagexray.statistics
- const currentXray = currentRaw.pagexray.statistics

//- The per-metric row ids keep the old graph-anchor scheme
//- (#chart-<group>_<metric>) so deep links into the previous layout
//- keep landing on the right metric.
- var chartId = function(metricGroup, metricName) {
-   return 'chart-' + metricGroup.replace(/\./g, '_') + '_' + metricName.replace(/\./g, '_')
- }
- var cliffDeltaHelper = function(delta) {
-   const size = Math.abs(delta)
-   if (size < 0.147) return 'negligible effect (' + h.decimals(delta) + ')'
-   if (size < 0.3) return 'small effect (' + h.decimals(delta) + ')'
-   if (size < 0.5) return 'medium effect (' + h.decimals(delta) + ')'
-   return 'large effect (' + h.decimals(delta) + ')'
- }
//- The middle-80% band (p10–p90) drawn behind the dots needs quantiles;
//- linear interpolation between the two straddling runs, same method the
//- reconstruction uses. Returns lo-safe 0 for an empty series.
- var quantile = function(arr, q) {
-   const s = arr.filter(x => typeof x === 'number').slice().sort((a, b) => a - b)
-   if (s.length === 0) return 0
-   const pos = (s.length - 1) * q
-   const base = Math.floor(pos)
-   const rest = pos - base
-   return s[base + 1] !== undefined ? s[base] + rest * (s[base + 1] - s[base]) : s[base]
- }
- var isInformational = function(s) {
-   return s === 'N/A' || s === 'Datasets are identical' || s === 'No variability' || s === 'Datasets have different lengths'
- }
//- When the runs concentrate on a handful of distinct values (WebPageReplay
//- ttfb: twenty runs at 303 ms against one at 304 ms) individual dots pile
//- up invisibly and the strip reads as one run against one outlier — those
//- values render as a counted pill instead. Dense continuous data keeps
//- plain dots with the deterministic jitter.
- var railMarks = function(vals) {
-   const counts = new Map()
-   for (const v of vals) if (typeof v === 'number') counts.set(v, (counts.get(v) || 0) + 1)
-   const groups = [...counts.entries()].sort((a, b) => a[0] - b[0]).map(e => ({ value: e[0], count: e[1] }))
-   const usePiles = groups.length <= 5
-   const piles = []
-   const dots = []
-   for (const g of groups) {
-     if (usePiles && g.count > 2) piles.push(g)
-     else for (let i = 0; i < g.count; i++) dots.push({ value: g.value, count: g.count, jitter: (i % 3 - 1) * 3 })
-   }
-   return { piles, dots }
- }
- var fmtCount = function(stats) {
-   if (!stats) return '–'
-   const count = stats.requests ? stats.requests.median : (stats.median !== undefined ? stats.median : '')
-   const transfer = stats.transferSize ? h.size.format(stats.transferSize.median) : null
-   const content = stats.contentSize ? h.size.format(stats.contentSize.median) : null
-   let extra = ''
-   if (transfer && content) extra = ' (' + transfer + ' / ' + content + ')'
-   else if (transfer) extra = ' (' + transfer + ')'
-   return count + extra
- }
//- Adaptive precision: whole numbers from three digits up, one decimal
//- in the tens, two below, and two significant digits under 0.1 —
//- keeps 5.593 from meeting 288 in the same column with different
//- noise levels, while a CLS of 0.0005 stays 0.0005 instead of
//- collapsing to 0 (which made flagged CLS rows read "0 → 0, Δ 0").
- var fmtVal = function(v) {
-   if (v === null || v === undefined || Number.isNaN(v)) return '–'
-   const size = Math.abs(v)
-   if (size >= 100 || v === Math.round(v)) return String(Math.round(v))
-   if (size >= 10) return v.toFixed(1)
-   if (size >= 0.095) return String(Math.round(v * 100) / 100)
-   return String(Number(v.toPrecision(2)))
- }
//- The compare helper only ships a fixed set of groups (helper.js), so
//- units can be derived from group + metric name. Unknown groups (user
//- extras) get no unit rather than a guessed one.
- var metricUnit = function(groupName, metricName) {
-   if (groupName === 'timings' || groupName === 'visualMetrics' || groupName === 'userTimings' || groupName === 'elementTimings') return ' ms'
-   if (groupName === 'googleWebVitals') return metricName === 'cumulativeLayoutShift' ? '' : ' ms'
-   if (groupName === 'renderBlocking') return metricName.endsWith('ms') ? ' ms' : ''
-   if (groupName === 'cpu') return metricName === 'tasks' ? '' : ' ms'
-   return ''
- }

- const testName = meta.testOptions.testType === 'mannwhitneyu' ? 'Mann-Whitney U' : 'Wilcoxon signed-rank'
- const alternative = meta.testOptions.alternative
- const sigWord = alternative === 'greater' ? 'slower' : (alternative === 'less' ? 'faster' : 'changed')
//- A significant change is only bad news when it points the wrong way:
//- "faster" gets the good tone, "slower" the error tone. All compared
//- metrics are lower-is-better. For two-sided tests the direction
//- comes from the Cliff's delta sign per metric (positive = current
//- ranks higher = slower).
- var directionFor = function(cliffs) {
-   if (alternative === 'greater') return 'slower'
-   if (alternative === 'less') return 'faster'
-   if (cliffs > 0) return 'slower'
-   if (cliffs < 0) return 'faster'
-   return 'changed'
- }
- var toneFor = function(direction) {
-   return direction === 'faster' ? 'ok' : (direction === 'slower' ? 'error' : 'neutral')
- }

//- Metrics whose baseline AND current run arrays are identical to an
//- earlier metric in the same group merge into one row (before-FCP and
//- before-LCP pairs whenever FCP and LCP are the same paint) so the
//- same finding isn't rendered and counted twice. Guard on
//- baseline/current existing — extras metrics can arrive half-shaped
//- when a metric is missing on one side.
- const mergedGroups = {}
- for (const mGroupName in compare.metrics) {
-   const mRows = []
-   for (const mMetricName in compare.metrics[mGroupName]) {
-     const v = compare.metrics[mGroupName][mMetricName]
-     if (!v || !v.baseline || !v.current || !Array.isArray(v.baseline.values) || !Array.isArray(v.current.values)) continue
-     const runsKey = JSON.stringify(v.baseline.values) + '|' + JSON.stringify(v.current.values)
-     const twin = mRows.find(r => r.runsKey === runsKey)
-     if (twin) twin.metricNames.push(mMetricName)
-     else mRows.push({ metricNames: [mMetricName], values: v, runsKey })
-   }
-   if (mRows.length > 0) mergedGroups[mGroupName] = mRows
- }

//- Count the merged rows once so the verdict can say "5 of 24". A row
//- that tests significant while both medians DISPLAY the same value is
//- statistically detectable but too small to matter (the Wikimedia CLS
//- case: 0.0005 → 0.0005 with p = 0.029 because a tiny shift happens
//- in more runs) — those go in their own bucket so they don't read as
//- regressions. A row the rank test passes but Kolmogorov-Smirnov flags
//- changed distribution SHAPE while the median held (spread grew, runs
//- split into two groups — an intermittent slow path) and gets its own
//- bucket too.
- const significantMetrics = []
- const tinyMetrics = []
- const shapeMetrics = []
- let totalMetrics = 0
- for (const vGroupName in mergedGroups) {
-   for (const vRow of mergedGroups[vGroupName]) {
-     totalMetrics++
-     const vScore = vRow.values.statisticalTestU
-     if (isInformational(vScore)) continue
-     const entry = { name: vGroupName + '.' + vRow.metricNames.join(' + '), href: chartId(vGroupName, vRow.metricNames[0]), tone: toneFor(directionFor(vRow.values.cliffsDelta)) }
-     const vKS = vRow.values.statisticalTestKS
-     if (vScore >= 0.05) {
-       //- Mirrors the per-row shapeChange condition: a large effect in
-       //- the direction the one-sided test ignores is the likely-opposite
-       //- story, not a shape story, even when K-S fires on it.
-       const vCliffs = vRow.values.cliffsDelta
-       const vLikelyOpposite = alternative !== 'two-sided' && typeof vCliffs === 'number' && Math.abs(vCliffs) >= 0.474 && (alternative === 'greater' ? vCliffs < 0 : vCliffs > 0)
-       if (!vLikelyOpposite && typeof vKS === 'number' && vKS < 0.05) shapeMetrics.push(entry)
-       continue
-     }
-     if (fmtVal(vRow.values.baseline.median) === fmtVal(vRow.values.current.median)) tinyMetrics.push(entry)
-     else significantMetrics.push(entry)
-   }
- }

- const groupTitles = { timings: 'Timings', visualMetrics: 'Visual metrics', googleWebVitals: 'Google Web Vitals', renderBlocking: 'Render blocking', elementTimings: 'Element timings', userTimings: 'User timings', cpu: 'CPU long tasks', browser: 'Browser' }

a#compare
h1.cmp-title Compare

if meta.iterations < 21
  .cmp-alert.cmp-alert--warning
    | The number of iterations (#{meta.iterations}) is less than the&nbsp;
    a(href='https://en.wikipedia.org/wiki/Mann–Whitney_U_test#Calculations') recommended minimum of 21
    | . This may impact the reliability of the statistical comparison.

//- ---------------------------------------------------------------------
//- Setup strip — what was tested against what and how. One line instead
//- of the old Settings + Run setup cards; the screenshots/video live in
//- the collapsed details block below.
//- ---------------------------------------------------------------------
.cmp-setupline
  span
    span.cmp-setup-key Test
    b #{testName}
    if alternative === 'greater'
      |  · greater (is current slower/higher?)
    else if alternative === 'less'
      |  · less (is current faster/lower?)
    else
      |  · two-sided (change in either direction)
  span
    span.cmp-setup-key Iterations
    b #{meta.iterations}
  span
    span.cmp-setup-key Baseline
    | #{meta.baseline.timestamp}
  span
    span.cmp-setup-key Current
    | #{meta.current.timestamp}
  if meta.testOptions.testType === 'mannwhitneyu'
    span.cmp-setup-extra
      | method #{meta.testOptions.mannwhitneyu.method} · continuity #{meta.testOptions.mannwhitneyu.useContinuity ? 'enabled' : 'disabled'} ·&nbsp;
      a(href='https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.mannwhitneyu.html') about the test
  else if meta.testOptions.testType === 'wilcoxon'
    span.cmp-setup-extra
      | correction #{meta.testOptions.wilcoxon.correction ? 'enabled' : 'disabled'} ·&nbsp;
      a(href='https://docs.scipy.org/doc/scipy/reference/generated/scipy.stats.wilcoxon.html') about the test

//- Cards use <div> rather than <section> because the page-level tab JS
//- hides every `#tabSections section` and only un-hides the active
//- panel — nested <section> elements stay display:none.
details.cmp-run-details
  summary Run setup: screenshots, video and full results
  .cmp-runs
    each run, key in {baseline: {meta: meta.baseline, raw: baselineRaw}, current: {meta: meta.current, raw: currentRaw}}
      .cmp-run(class='cmp-run--' + key)
        .cmp-run-head
          span.cmp-run-tag(class='cmp-run-tag--' + key) #{key === 'baseline' ? 'Baseline' : 'Current'}
          span.cmp-run-timestamp #{run.meta.timestamp}
        a.cmp-run-url(href=run.meta.url) #{run.meta.alias || run.meta.url}
        if run.raw.pagexray.meta.screenshot
          a.cmp-run-thumb(href=run.raw.pagexray.meta.screenshot, target='_blank', rel='noopener')
            img(src=run.raw.pagexray.meta.screenshot, alt=key + ' screenshot', loading='lazy')
        if run.raw.pagexray.meta.video
          .cmp-run-video
            video(controls, preload='none')
              source(src=run.raw.pagexray.meta.video, type='video/mp4')
        if run.raw.pagexray.meta.result
          a.cmp-run-result(href=run.raw.pagexray.meta.result, target='_blank', rel='noopener') Open full result

//- ---------------------------------------------------------------------
//- Content breakdown — request counts and transfer sizes per resource
//- type. Answers "did the page get heavier?" before the timing story.
//- ---------------------------------------------------------------------
.cmp-card
  .cmp-card-header
    h2.cmp-card-title Content breakdown
  table.cmp-types
    thead
      tr
        th Resource
        th.cmp-types-num Baseline
        th.cmp-types-num Current
    tbody
      tr
        td Total
        td.cmp-types-num #{fmtCount(baselineXray)}
        td.cmp-types-num #{fmtCount(currentXray)}
      tr
        td HTML
        td.cmp-types-num #{fmtCount(baselineXray.contentTypes.html)}
        td.cmp-types-num #{fmtCount(currentXray.contentTypes.html)}
      tr
        td JavaScript
        td.cmp-types-num #{fmtCount(baselineXray.contentTypes.javascript)}
        td.cmp-types-num #{fmtCount(currentXray.contentTypes.javascript)}
      tr
        td CSS
        td.cmp-types-num #{fmtCount(baselineXray.contentTypes.css)}
        td.cmp-types-num #{fmtCount(currentXray.contentTypes.css)}
      tr
        td Images
        td.cmp-types-num #{fmtCount(baselineXray.contentTypes.image)}
        td.cmp-types-num #{fmtCount(currentXray.contentTypes.image)}
      tr
        td DOM elements
        td.cmp-types-num #{baselineRaw.browsertime.statistics.pageinfo.domElements.median}
        td.cmp-types-num #{currentRaw.browsertime.statistics.pageinfo.domElements.median}

//- ---------------------------------------------------------------------
//- Verdict — the headline answer, with chips that jump to the flagged
//- metrics. The legend for the strips lives here so it renders once,
//- not once per row.
//- ---------------------------------------------------------------------
.cmp-verdict
  .cmp-verdict-line
    if significantMetrics.length > 0
      b #{significantMetrics.length} of #{totalMetrics}
      |  #{significantMetrics.length === 1 ? 'metrics is' : 'metrics are'} significantly #{sigWord} compared to the baseline (p &lt; 0.05).
    else
      b None
      |  of the #{totalMetrics} compared metrics show a significant change against the baseline (p &lt; 0.05).
  if tinyMetrics.length > 0
    .cmp-verdict-sub #{tinyMetrics.map(t => t.name).join(', ')} also #{tinyMetrics.length === 1 ? 'tests' : 'test'} significant but the medians display the same value, too small to matter.
  if shapeMetrics.length > 0
    .cmp-verdict-sub #{shapeMetrics.map(t => t.name).join(', ')} changed run-to-run behaviour while the median held, which can mean an intermittent slow path.
  if significantMetrics.length > 0 || tinyMetrics.length > 0 || shapeMetrics.length > 0
    .cmp-verdict-chips
      each sig in significantMetrics
        a.cmp-verdict-chip(class='cmp-verdict-chip--' + sig.tone, href='#' + sig.href) #{sig.name}
      each tiny in tinyMetrics
        a.cmp-verdict-chip.cmp-verdict-chip--warning(href='#' + tiny.href) #{tiny.name}
      each shape in shapeMetrics
        a.cmp-verdict-chip.cmp-verdict-chip--warning(href='#' + shape.href) #{shape.name}
  .cmp-legend
    span
      span.cmp-swatch.cmp-swatch--baseline
      | Baseline: each dot is one run, a numbered dot is that many runs on one value, the tall tick is the median
    span
      span.cmp-swatch.cmp-swatch--current
      | Current
    span
      span.cmp-swatch.cmp-swatch--band
      | Shaded bar: middle 80% of runs
    span
      span.cmp-swatch.cmp-swatch--overlap
      | Grey: the two ranges overlap — that much of the shift is run-to-run noise

//- ---------------------------------------------------------------------
//- One row per metric: name + p-value, the distribution strip (both
//- runs on a shared value axis — run order carries no meaning for
//- independent samples, distributions do), median → median with the
//- delta, and the verdict chip. Replaces the old wide stats table and
//- the per-metric run-index scatter cards. Rows come pre-merged from
//- mergedGroups: a merged row lists every metric name in the group that
//- carries the exact same run values, and keeps every #chart- anchor.
//- ---------------------------------------------------------------------
each groupRows, groupName in mergedGroups
  .cmp-group
    .cmp-group-head
      h2.cmp-group-title #{groupTitles[groupName] || groupName}
    each row in groupRows
      - const metricNames = row.metricNames
      - const values = row.values
      - const unit = metricUnit(groupName, metricNames[0])
      - const score = values.statisticalTestU
      - const informational = isInformational(score)
      - const significant = !informational && score < 0.05
      - const direction = directionFor(values.cliffsDelta)
      - const tone = toneFor(direction)
      - const baseline = values.baseline.values
      - const current = values.current.values
      - const allValues = baseline.concat(current).filter(v => typeof v === 'number')
      - const lo = allValues.length > 0 ? Math.min.apply(null, allValues) : 0
      - const hi = allValues.length > 0 ? Math.max.apply(null, allValues) : 0
      - const span = hi - lo
      - const medB = values.baseline.median
      - const medC = values.current.median
      - const delta = medC - medB
      - const deltaPct = medB !== 0 ? Math.round(delta / medB * 1000) / 10 : undefined
      //- Statistically detectable while both medians DISPLAY the same
      //- value — real (the distribution moved) but too small to matter,
      //- so it gets the warning tone instead of reading as a regression.
      - const tinyChange = significant && fmtVal(medB) === fmtVal(medC)
      //- With a one-sided test an improvement can never be significant:
      //- p = 1 with a large opposite-direction effect used to render
      //- "no change". Call the large opposite effect out honestly.
      - const oppositeDirection = alternative === 'greater' ? 'faster' : (alternative === 'less' ? 'slower' : undefined)
      - const likelyOpposite = !significant && !informational && oppositeDirection !== undefined && typeof values.cliffsDelta === 'number' && Math.abs(values.cliffsDelta) >= 0.474 && (alternative === 'greater' ? values.cliffsDelta < 0 : values.cliffsDelta > 0)
      //- Kolmogorov-Smirnov compares whole distributions, so it catches
      //- what the rank test misses: the median holding while the spread
      //- grows or the runs split into two groups (an intermittent slow
      //- path). Only surfaced when neither the rank test nor the
      //- likely-opposite call flagged the row — K-S also fires on plain
      //- location shifts, and double-flagging the same finding helps
      //- nobody. Keep the condition in sync with the verdict count above.
      - const ksScore = values.statisticalTestKS
      - const shapeChange = !significant && !informational && !likelyOpposite && typeof ksScore === 'number' && ksScore < 0.05
      //- Positions are percentages with a small inset so edge dots
      //- don't clip; computed in code lines because pug's attribute
      //- parser trips on division after a bracket.
      - const pad = 4
      - const xPos = function(v) { return (pad + (v - lo) / span * (100 - 2 * pad)).toFixed(2) }
      - const xPosN = function(v) { return pad + (v - lo) / span * (100 - 2 * pad) }
      //- Middle-80% range per series, and the value window where the two
      //- ranges overlap — a wide overlap says the change sits inside the
      //- run-to-run noise, a clean gap says it's real.
      - const p10B = quantile(baseline, 0.1), p90B = quantile(baseline, 0.9)
      - const p10C = quantile(current, 0.1), p90C = quantile(current, 0.9)
      - const ovLo = Math.max(p10B, p10C), ovHi = Math.min(p90B, p90C)
      - const hasOverlap = ovHi > ovLo
      - const marksB = railMarks(baseline)
      - const marksC = railMarks(current)
      //- Shape-changed rows share the warning styling classes — the
      //- "significant" class here is a styling scope, not a claim about
      //- the rank test.
      - const rowClass = significant ? 'cmp-metric--significant cmp-metric--' + (tinyChange ? 'warning' : tone) : (shapeChange ? 'cmp-metric--significant cmp-metric--warning' : null)
      .cmp-metric(id=chartId(groupName, metricNames[0]), class=rowClass)
        each mn, mi in metricNames
          if mi > 0
            a.cmp-metric-anchor(id=chartId(groupName, mn))
        .cmp-metric-name
          each mn in metricNames
            b #{mn}
          small #{informational ? 'no test' : 'p = ' + h.decimals(score)}
          if metricNames.length > 1
            span.cmp-same identical values
        .cmp-metric-strip
          if span > 0
            .cmp-strip
              .cmp-strip-row
                .cmp-strip-gutter
                  span.cmp-strip-gutter-label.cmp-strip-gutter-label--baseline Baseline
                  span.cmp-strip-gutter-label.cmp-strip-gutter-label--current Current
                .cmp-strip-rails
                  if hasOverlap
                    span.cmp-strip-overlap(style='left:' + xPosN(ovLo).toFixed(2) + '%;width:' + Math.max(0.5, xPosN(ovHi) - xPosN(ovLo)).toFixed(2) + '%', title='The two normal ranges overlap here — this much of the shift is inside run-to-run noise')
                  .cmp-strip-rail
                    span.cmp-strip-band.cmp-strip-band--baseline(style='left:' + xPosN(p10B).toFixed(2) + '%;width:' + Math.max(0.5, xPosN(p90B) - xPosN(p10B)).toFixed(2) + '%', title='Baseline: middle 80% of runs ' + fmtVal(p10B) + '–' + fmtVal(p90B) + unit)
                    span.cmp-strip-median.cmp-strip-median--baseline(style='left:' + xPos(medB) + '%', title='Baseline median ' + fmtVal(medB) + unit)
                    each g in marksB.piles
                      span.cmp-strip-pile.cmp-strip-pile--baseline(style='left:' + xPos(g.value) + '%', title='Baseline: ' + g.count + ' runs at ' + fmtVal(g.value) + unit) #{g.count}
                    each d in marksB.dots
                      span.cmp-strip-dot.cmp-strip-dot--baseline(style='left:' + xPos(d.value) + '%;margin-top:' + d.jitter + 'px', title='Baseline: ' + (d.count > 1 ? d.count + ' runs' : '1 run') + ' at ' + fmtVal(d.value) + unit)
                  .cmp-strip-rail
                    span.cmp-strip-band.cmp-strip-band--current(style='left:' + xPosN(p10C).toFixed(2) + '%;width:' + Math.max(0.5, xPosN(p90C) - xPosN(p10C)).toFixed(2) + '%', title='Current: middle 80% of runs ' + fmtVal(p10C) + '–' + fmtVal(p90C) + unit)
                    span.cmp-strip-median.cmp-strip-median--current(style='left:' + xPos(medC) + '%', title='Current median ' + fmtVal(medC) + unit)
                    each g in marksC.piles
                      span.cmp-strip-pile.cmp-strip-pile--current(style='left:' + xPos(g.value) + '%', title='Current: ' + g.count + ' runs at ' + fmtVal(g.value) + unit) #{g.count}
                    each d in marksC.dots
                      span.cmp-strip-dot.cmp-strip-dot--current(style='left:' + xPos(d.value) + '%;margin-top:' + d.jitter + 'px', title='Current: ' + (d.count > 1 ? d.count + ' runs' : '1 run') + ' at ' + fmtVal(d.value) + unit)
              .cmp-strip-axis
                span #{fmtVal(lo)}#{unit}
                span #{fmtVal(hi)}#{unit}
          else
            p.cmp-metric-flat
              | all #{baseline.length}+#{current.length} runs measured&nbsp;
              b #{fmtVal(lo)}#{unit}
              | , so nothing to compare
        //- Median → median stays for reference, but the percentage delta
        //- is only shown when the change is significant: a "+3 %" on a
        //- noise row reads as a real regression the overlap band denies.
        //- Non-significant rows are muted so the effect-size chip leads.
        //- The Hodges-Lehmann line under it is the honest size estimate:
        //- the shift with a confidence interval, where the p-value only
        //- says how consistent the shift is.
        - const shift = values.shift
        .cmp-metric-delta(class=significant ? null : 'cmp-metric-delta--quiet')
          if span > 0
            b
              | #{fmtVal(medB)}&nbsp;
              span.cmp-arrow →
              | &nbsp;#{fmtVal(medC)}#{unit}
            if tinyChange
              //- The medians display the same value — the means carry
              //- what actually moved.
              small mean #{fmtVal(values.baseline.mean)} → #{fmtVal(values.current.mean)}#{unit}
            else if significant && medB !== 0
              small Δ #{delta > 0 ? '+' : ''}#{fmtVal(delta)}#{unit} (#{deltaPct > 0 ? '+' : ''}#{deltaPct} %)
            else if medB === 0 && delta === 0
              //- Both medians are zero but the runs differ — the
              //- means carry the story (flaky CPU long tasks do this).
              small mean #{fmtVal(values.baseline.mean)} → #{fmtVal(values.current.mean)}#{unit}
            else
              small Δ #{delta > 0 ? '+' : ''}#{fmtVal(delta)}#{unit}
            if !informational && shift && shift.lower !== undefined
              small(title='Hodges-Lehmann estimate: the median of all pairwise current vs baseline differences, with a ' + Math.round(shift.confidence * 100) + '% confidence interval from the same pairwise differences') shift #{shift.estimate > 0 ? '+' : ''}#{fmtVal(shift.estimate)} (#{shift.lower > 0 ? '+' : ''}#{fmtVal(shift.lower)} to #{shift.upper > 0 ? '+' : ''}#{fmtVal(shift.upper)}#{unit})
        //- The effect size (Cliff's delta) rides under the chip for every
        //- row, significant or not — it's the overlap-aware "how big",
        //- the honest counterweight to the raw median difference. The
        //- pill itself stays a short verdict so it never wraps mid-number.
        .cmp-metric-chip
          if informational
            span.cmp-chip.cmp-chip--neutral #{score === 'Datasets are identical' ? 'identical runs' : String(score).toLowerCase()}
          else if tinyChange
            - const zeroB = baseline.filter(v => v === 0).length
            - const zeroC = current.filter(v => v === 0).length
            span.cmp-chip.cmp-chip--warning detectable, tiny
            small.cmp-effect #{cliffDeltaHelper(values.cliffsDelta)}
            if zeroB !== zeroC && (zeroB > 0 || zeroC > 0)
              small.cmp-effect nonzero in #{current.length - zeroC} of #{current.length} runs, was #{baseline.length - zeroB} of #{baseline.length}
            else
              small.cmp-effect medians are the same
          else if significant
            span.cmp-chip(class='cmp-chip--' + tone) #{direction}
            small.cmp-effect #{cliffDeltaHelper(values.cliffsDelta)}
          else if likelyOpposite
            span.cmp-chip(class='cmp-chip--' + toneFor(oppositeDirection)) likely #{oppositeDirection}
            small.cmp-effect #{cliffDeltaHelper(values.cliffsDelta)}
            small.cmp-effect one-sided test only checks #{sigWord}
          else if shapeChange
            span.cmp-chip.cmp-chip--warning spread changed
            small.cmp-effect median held, distribution changed (KS p = #{h.decimals(ksScore)})
            small.cmp-effect middle 80% of runs span #{fmtVal(p90B - p10B)} → #{fmtVal(p90C - p10C)}#{unit}
          else
            span.cmp-chip.cmp-chip--neutral no change
            small.cmp-effect #{cliffDeltaHelper(values.cliffsDelta)}
